<ui:FluentWindow
    x:Class="PamRdpProxyManager.Views.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Anmelden – Imprivata PAM RDP Proxy Manager"
    Width="460"
    Icon="pack://application:,,,/Assets/app.ico"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="NoResize"
    SizeToContent="Height"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="Imprivata PAM RDP Proxy Manager"
            Grid.Row="0"
            ShowMaximize="False"
            ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <StackPanel Grid.Row="1" Margin="32,4,32,28">
            <StackPanel Orientation="Horizontal">
                <Image
                    Width="48"
                    Height="48"
                    Margin="0,0,16,0"
                    Source="pack://application:,,,/Assets/app.png" />
                <StackPanel VerticalAlignment="Center">
                    <ui:TextBlock FontTypography="Subtitle" Text="Anmelden" />
                    <ui:TextBlock
                        x:Name="ServerInfo"
                        Appearance="Secondary"
                        Text="PAM-Server" />
                </StackPanel>
            </StackPanel>

            <ui:InfoBar
                x:Name="NoticeBar"
                Title="Abgemeldet"
                Margin="0,14,0,0"
                IsClosable="True"
                IsOpen="False"
                Severity="Informational" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="Benutzername" />
            <ui:TextBox
                x:Name="UserNameBox"
                AutomationProperties.Name="Benutzername"
                PlaceholderText="z. B. jdoe">
                <ui:TextBox.Icon>
                    <ui:SymbolIcon Symbol="Person24" />
                </ui:TextBox.Icon>
            </ui:TextBox>

            <TextBlock Style="{StaticResource FieldLabel}" Text="Passwort" />
            <PasswordBox x:Name="PasswordBox" AutomationProperties.Name="Passwort" />

            <CheckBox
                x:Name="RememberBox"
                Margin="0,14,0,0"
                Content="Benutzernamen merken" />

            <TextBlock
                x:Name="ErrorText"
                Margin="0,10,0,0"
                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <ui:TextBlock
                Margin="0,14,0,0"
                Appearance="Tertiary"
                FontSize="12"
                Text="Das Passwort wird ausschließlich im Arbeitsspeicher gehalten und nie gespeichert. Das Confirm-ID-Token wird erst beim Verbinden abgefragt."
                TextWrapping="Wrap" />

            <StackPanel
                Margin="0,22,0,0"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <ui:Button
                    MinWidth="110"
                    Margin="0,0,8,0"
                    Content="Abbrechen"
                    IsCancel="True" />
                <ui:Button
                    MinWidth="110"
                    Appearance="Primary"
                    Click="OnLoginClick"
                    Content="Anmelden"
                    IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
