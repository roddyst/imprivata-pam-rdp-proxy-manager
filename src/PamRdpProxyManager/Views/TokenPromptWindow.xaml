<ui:FluentWindow
    x:Class="PamRdpProxyManager.Views.TokenPromptWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Confirm-ID-Token"
    Width="440"
    Icon="pack://application:,,,/Assets/app.ico"
    ExtendsContentIntoTitleBar="True"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="Imprivata PAM RDP Proxy Manager"
            Grid.Row="0"
            ShowMaximize="False"
            ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <StackPanel Grid.Row="1" Margin="28,4,28,24">
            <ui:TextBlock FontTypography="Subtitle" Text="Imprivata ID Token" />
            <ui:TextBlock
                x:Name="TargetInfo"
                Margin="0,4,0,0"
                Appearance="Secondary"
                TextWrapping="Wrap" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="Confirm-ID-Token" />
            <ui:TextBox
                x:Name="TokenBox"
                AutomationProperties.Name="Confirm-ID-Token"
                PlaceholderText="Imprivata ID Token">
                <ui:TextBox.Icon>
                    <ui:SymbolIcon Symbol="ShieldKeyhole24" />
                </ui:TextBox.Icon>
            </ui:TextBox>

            <TextBlock
                x:Name="ErrorText"
                Margin="0,10,0,0"
                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button
                    Grid.Column="0"
                    Appearance="Transparent"
                    Click="OnWithoutTokenClick"
                    Content="Ohne Token"
                    ToolTip="Ohne Confirm-ID-Token verbinden (benutzer##zielserver)" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ui:Button
                        MinWidth="100"
                        Margin="0,0,8,0"
                        Content="Abbrechen"
                        IsCancel="True" />
                    <ui:Button
                        MinWidth="110"
                        Appearance="Primary"
                        Click="OnConnectClick"
                        Content="Verbinden"
                        IsDefault="True">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="PlugConnected24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
