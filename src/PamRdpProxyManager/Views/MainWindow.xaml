<ui:FluentWindow
    x:Class="PamRdpProxyManager.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:b="clr-namespace:PamRdpProxyManager.Behaviors"
    xmlns:vm="clr-namespace:PamRdpProxyManager.ViewModels"
    Title="Imprivata PAM RDP Proxy Manager"
    Width="1040"
    Height="720"
    MinWidth="820"
    MinHeight="560"
    d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
    Icon="pack://application:,,,/Assets/app.ico"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="Imprivata PAM RDP Proxy Manager" Grid.Row="0">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:InfoBar
            Title="Nicht-portabler Modus"
            Grid.Row="1"
            Margin="20,0,20,8"
            IsClosable="True"
            IsOpen="{Binding HasStorageNotice, Mode=OneTime}"
            Message="{Binding StorageNotice, Mode=OneTime}"
            Severity="Warning" />

        <TabControl Grid.Row="2" Margin="16,0,16,16">

            <!-- ==================== Connect ==================== -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,6,0" Symbol="DesktopArrowRight24" />
                        <TextBlock Text="Verbinden" />
                    </StackPanel>
                </TabItem.Header>

                <Grid Margin="4,12,4,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="5*" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ui:Card Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon
                                        Grid.Column="0"
                                        Margin="0,0,12,0"
                                        FontSize="22"
                                        Symbol="Person24" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <ui:TextBlock Appearance="Secondary" FontSize="12" Text="Angemeldet als" />
                                        <ui:TextBlock FontTypography="BodyStrong" Text="{Binding UserName}" />
                                    </StackPanel>
                                    <ui:Button
                                        Grid.Column="2"
                                        Command="{Binding LogoutCommand}"
                                        Content="Abmelden"
                                        ToolTip="Zugangsdaten verwerfen und neu anmelden">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="SignOut24" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </Grid>
                            </ui:Card>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Profil" />
                            <ComboBox
                                AutomationProperties.Name="Profil"
                                DisplayMemberPath="Name"
                                ItemsSource="{Binding Profiles}"
                                SelectedItem="{Binding SelectedProfile}" />
                            <TextBlock Style="{StaticResource Hint}">
                                <Run Text="PAM-Server (RDP-Proxy):" />
                                <Run Text="{Binding SelectedProfile.ProxyHost, Mode=OneWay}" /><Run Text=":" /><Run Text="{Binding SelectedProfile.Port, Mode=OneWay}" />
                            </TextBlock>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Zielserver (rdphost)" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox
                                    x:Name="TargetBox"
                                    AutomationProperties.Name="Zielserver"
                                    PlaceholderText="z. B. server01.example.com"
                                    Text="{Binding TargetHost, UpdateSourceTrigger=PropertyChanged}">
                                    <ui:TextBox.Icon>
                                        <ui:SymbolIcon Symbol="Server24" />
                                    </ui:TextBox.Icon>
                                </ui:TextBox>
                                <ui:Button
                                    Grid.Column="1"
                                    Height="{Binding ActualHeight, ElementName=TargetBox}"
                                    Margin="8,0,0,0"
                                    Command="{Binding AddFavoriteCommand}"
                                    ToolTip="Als Favorit speichern">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="StarAdd24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </Grid>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Confirm-ID-Token (optional)" />
                            <ui:TextBox
                                AutomationProperties.Name="Confirm-ID-Token"
                                PlaceholderText="Imprivata ID Token"
                                Text="{Binding Token, UpdateSourceTrigger=PropertyChanged}">
                                <ui:TextBox.Icon>
                                    <ui:SymbolIcon Symbol="ShieldKeyhole24" />
                                </ui:TextBox.Icon>
                            </ui:TextBox>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Benutzername für den Proxy" />
                            <Border
                                Padding="12,8"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <TextBlock
                                    FontFamily="Cascadia Mono, Consolas"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{Binding UsernamePreview}"
                                    TextTrimming="CharacterEllipsis" />
                            </Border>
                            <TextBlock Style="{StaticResource Hint}" Text="Format: benutzer#token#zielserver (ohne Token: benutzer##zielserver) – das Passwort wird separat übergeben." />

                            <StackPanel Margin="0,20,0,0" Orientation="Horizontal">
                                <ui:Button
                                    MinWidth="160"
                                    Padding="16,8"
                                    Appearance="Primary"
                                    Command="{Binding ConnectCommand}"
                                    Content="Verbinden"
                                    IsDefault="True">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="PlugConnected24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                                <ui:ProgressRing
                                    Width="22"
                                    Height="22"
                                    Margin="14,0,0,0"
                                    IsIndeterminate="True"
                                    Visibility="{Binding IsConnecting, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>

                            <ui:InfoBar
                                Title="{Binding StatusTitle}"
                                Margin="0,16,0,0"
                                IsClosable="True"
                                IsOpen="{Binding IsStatusOpen, Mode=TwoWay}"
                                Message="{Binding StatusMessage}"
                                Severity="{Binding StatusSeverity}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Favorites / recent targets -->
                    <ui:Card
                        Grid.Column="2"
                        Padding="12"
                        VerticalAlignment="Stretch"
                        VerticalContentAlignment="Stretch">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                <ui:SymbolIcon Margin="0,0,8,0" Symbol="History24" />
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Favoriten &amp; zuletzt verwendet" />
                            </StackPanel>
                            <TextBlock
                                DockPanel.Dock="Top"
                                Style="{StaticResource Hint}"
                                Text="Klick übernimmt das Ziel, Doppelklick verbindet direkt (ohne Token wird danach gefragt)." />
                            <TextBlock
                                Margin="0,24,0,0"
                                DockPanel.Dock="Top"
                                HorizontalAlignment="Center"
                                Style="{StaticResource Hint}"
                                Text="Noch keine Ziele verwendet."
                                Visibility="{Binding RecentTargets.Count, Converter={StaticResource ZeroToVisible}}" />
                            <ui:ListView
                                x:Name="RecentList"
                                Margin="0,8,0,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                ItemsSource="{Binding RecentTargets}"
                                MouseDoubleClick="OnRecentDoubleClick"
                                SelectedItem="{Binding SelectedRecentTarget}">
                                <ui:ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:Button
                                                Grid.Column="0"
                                                Padding="6"
                                                Appearance="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ui:ListView}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Favorit an/aus">
                                                <ui:Button.Icon>
                                                    <ui:SymbolIcon
                                                        Filled="{Binding IsFavorite}"
                                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                        Symbol="Star24" />
                                                </ui:Button.Icon>
                                            </ui:Button>
                                            <StackPanel
                                                Grid.Column="1"
                                                Margin="6,0"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                    Text="{Binding Host}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding LastUsed, StringFormat={}{0:dd.MM.yyyy HH:mm}, Mode=OneWay}" />
                                                    <Run Text="·" />
                                                    <Run Text="{Binding ProfileName, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <ui:Button
                                                Grid.Column="2"
                                                Padding="6"
                                                Appearance="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.ConnectToCommand, RelativeSource={RelativeSource AncestorType=ui:ListView}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Verbinden">
                                                <ui:Button.Icon>
                                                    <ui:SymbolIcon Foreground="{DynamicResource TextFillColorPrimaryBrush}" Symbol="PlugConnected24" />
                                                </ui:Button.Icon>
                                            </ui:Button>
                                            <ui:Button
                                                Grid.Column="3"
                                                Padding="6"
                                                Appearance="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.RemoveRecentCommand, RelativeSource={RelativeSource AncestorType=ui:ListView}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Aus der Liste entfernen">
                                                <ui:Button.Icon>
                                                    <ui:SymbolIcon Foreground="{DynamicResource TextFillColorPrimaryBrush}" Symbol="Dismiss24" />
                                                </ui:Button.Icon>
                                            </ui:Button>
                                        </Grid>
                                    </DataTemplate>
                                </ui:ListView.ItemTemplate>
                            </ui:ListView>
                        </DockPanel>
                    </ui:Card>
                </Grid>
            </TabItem>

            <!-- ==================== Settings ==================== -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Margin="0,0,6,0" Symbol="Settings24" />
                        <TextBlock Text="Einstellungen &amp; Profile" />
                    </StackPanel>
                </TabItem.Header>

                <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,4,12,12">

                        <!-- Profile -->
                        <ui:Card Padding="16" HorizontalContentAlignment="Stretch">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Profil" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox
                                        AutomationProperties.Name="Profil auswählen"
                                        DisplayMemberPath="Name"
                                        ItemsSource="{Binding Profiles}"
                                        SelectedItem="{Binding SelectedProfile}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <ui:Button Margin="8,0,0,0" Command="{Binding NewProfileCommand}" ToolTip="Neues Profil">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="Add24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                        <ui:Button Margin="8,0,0,0" Command="{Binding DuplicateProfileCommand}" ToolTip="Profil duplizieren">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="Copy24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                        <ui:Button Margin="8,0,0,0" Command="{Binding DeleteProfileCommand}" ToolTip="Profil löschen">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="Delete24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Profilname" />
                                <ui:TextBox Text="{Binding SelectedProfile.Name, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </ui:Card>

                        <!-- Server -->
                        <ui:Card Margin="0,12,0,0" Padding="16" HorizontalContentAlignment="Stretch">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="PAM-Server (RDP-Proxy)" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="180" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Hostname oder URL" />
                                        <ui:TextBox PlaceholderText="pam.example.com" Text="{Binding SelectedProfile.ProxyHost, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="RDP-Port" />
                                        <ui:TextBox
                                            b:NumericInput.IsEnabled="True"
                                            MaxLength="5"
                                            Text="{Binding SelectedProfile.Port, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}" Text="Eine URL wie https://pam.example.com/ wird automatisch auf den Hostnamen gekürzt. Standard-Port: 3388." />
                            </StackPanel>
                        </ui:Card>

                        <!-- Display -->
                        <ui:Card Margin="0,12,0,0" Padding="16" HorizontalContentAlignment="Stretch">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Anzeige" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Modus" />
                                        <ComboBox
                                            DisplayMemberPath="Text"
                                            ItemsSource="{Binding DisplayModes}"
                                            SelectedValue="{Binding SelectedProfile.Rdp.DisplayMode}"
                                            SelectedValuePath="Value" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Farbtiefe" />
                                        <ComboBox
                                            DisplayMemberPath="Text"
                                            ItemsSource="{Binding ColorDepths}"
                                            SelectedValue="{Binding SelectedProfile.Rdp.ColorDepth}"
                                            SelectedValuePath="Value" />
                                    </StackPanel>
                                </Grid>
                                <Grid IsEnabled="{Binding SelectedProfile.Rdp.IsWindowed}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Breite (Fenstermodus)" />
                                        <ui:TextBox
                                            b:NumericInput.IsEnabled="True"
                                            MaxLength="5"
                                            Text="{Binding SelectedProfile.Rdp.DesktopWidth, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Höhe (Fenstermodus)" />
                                        <ui:TextBox
                                            b:NumericInput.IsEnabled="True"
                                            MaxLength="5"
                                            Text="{Binding SelectedProfile.Rdp.DesktopHeight, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                                    </StackPanel>
                                </Grid>
                                <WrapPanel Margin="0,12,0,0">
                                    <ui:ToggleSwitch Margin="0,6,28,6" Content="Alle Monitore verwenden" IsChecked="{Binding SelectedProfile.Rdp.UseMultiMonitor}" />
                                    <ui:ToggleSwitch Margin="0,6,28,6" Content="Dynamische Auflösung" IsChecked="{Binding SelectedProfile.Rdp.DynamicResolution}" />
                                    <ui:ToggleSwitch Margin="0,6,28,6" Content="Smart Sizing (skalieren)" IsChecked="{Binding SelectedProfile.Rdp.SmartSizing}" />
                                </WrapPanel>
                            </StackPanel>
                        </ui:Card>

                        <!-- Local resources -->
                        <ui:Card Margin="0,12,0,0" Padding="16" HorizontalContentAlignment="Stretch">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Lokale Ressourcen" />
                                <WrapPanel Margin="0,8,0,0">
                                    <ui:ToggleSwitch Margin="0,6,28,6" Content="Zwischenablage" IsChecked="{Binding SelectedProfile.Rdp.RedirectClipboard}" />
                                    <ui:ToggleSwitch Margin="0,6,28,6" Content="Laufwerke umleiten" IsChecked="{Binding SelectedProfile.Rdp.RedirectDrives}" />
                                    <ui:ToggleSwitch Margin="0,6,28,6" Content="Drucker umleiten" IsChecked="{Binding SelectedProfile.Rdp.RedirectPrinters}" />
                                    <ui:ToggleSwitch Margin="0,6,28,6" Content="Mikrofon (Audioaufnahme)" IsChecked="{Binding SelectedProfile.Rdp.AudioCapture}" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Audiowiedergabe" />
                                <ComboBox
                                    MaxWidth="420"
                                    HorizontalAlignment="Left"
                                    DisplayMemberPath="Text"
                                    ItemsSource="{Binding AudioModes}"
                                    MinWidth="320"
                                    SelectedValue="{Binding SelectedProfile.Rdp.AudioMode}"
                                    SelectedValuePath="Value" />
                            </StackPanel>
                        </ui:Card>

                        <!-- Security -->
                        <ui:Card Margin="0,12,0,0" Padding="16" HorizontalContentAlignment="Stretch">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Sicherheit &amp; Verbindung" />
                                <WrapPanel Margin="0,8,0,0">
                                    <ui:ToggleSwitch Margin="0,6,28,6" Content="Network Level Authentication (NLA/CredSSP)" IsChecked="{Binding SelectedProfile.Rdp.EnableNla}" />
                                    <ui:ToggleSwitch Margin="0,6,28,6" Content="Automatisch wiederverbinden" IsChecked="{Binding SelectedProfile.Rdp.AutoReconnect}" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Wenn die Serverauthentifizierung fehlschlägt" />
                                <ComboBox
                                    MinWidth="320"
                                    MaxWidth="420"
                                    HorizontalAlignment="Left"
                                    DisplayMemberPath="Text"
                                    ItemsSource="{Binding AuthenticationLevels}"
                                    SelectedValue="{Binding SelectedProfile.Rdp.AuthenticationLevel}"
                                    SelectedValuePath="Value" />
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Zusätzliche RDP-Einstellungen (eine pro Zeile, z. B. keyboardhook:i:2)" />
                                <ui:TextBox
                                    MinHeight="80"
                                    AcceptsReturn="True"
                                    FontFamily="Cascadia Mono, Consolas"
                                    Text="{Binding SelectedProfile.Rdp.AdditionalSettings, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="NoWrap"
                                    VerticalScrollBarVisibility="Auto" />
                                <TextBlock Style="{StaticResource Hint}" Text="Einträge für Benutzername, Passwort und Serveradresse werden aus Sicherheitsgründen ignoriert." />
                            </StackPanel>
                        </ui:Card>

                        <!-- App -->
                        <ui:Card Margin="0,12,0,0" Padding="16" HorizontalContentAlignment="Stretch">
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionHeader}" Text="Anwendung (gilt für alle Profile)" />
                                <WrapPanel Margin="0,8,0,0">
                                    <ui:ToggleSwitch Margin="0,6,28,6" Content="Benutzernamen merken" IsChecked="{Binding RememberUserName}" />
                                    <ui:ToggleSwitch Margin="0,6,28,6" Content="Token nach dem Verbinden leeren" IsChecked="{Binding ClearTokenAfterConnect}" />
                                </WrapPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Design" />
                                        <ComboBox
                                            DisplayMemberPath="Text"
                                            ItemsSource="{Binding Themes}"
                                            SelectedValue="{Binding Theme}"
                                            SelectedValuePath="Value" />
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Zugangsdaten entfernen nach (Sekunden)" />
                                        <ui:TextBox
                                            b:NumericInput.IsEnabled="True"
                                            MaxLength="5"
                                            Text="{Binding CleanupDelaySeconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Anzahl zuletzt verwendeter Ziele" />
                                        <ui:TextBox
                                            b:NumericInput.IsEnabled="True"
                                            MaxLength="5"
                                            Text="{Binding MaxRecentTargets, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource Hint}" Text="Der temporäre Windows-Anmeldeeintrag TERMSRV/&lt;PAM-Server&gt; und die .rdp-Datei werden entfernt, sobald mstsc beendet ist oder diese Zeit abgelaufen ist." />

                                <TextBlock Style="{StaticResource FieldLabel}" Text="Einstellungsdatei" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="Cascadia Mono, Consolas"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding SettingsFilePath, Mode=OneTime}"
                                        TextTrimming="CharacterEllipsis" />
                                    <ui:Button
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Command="{Binding OpenSettingsFolderCommand}"
                                        Content="Ordner öffnen">
                                        <ui:Button.Icon>
                                            <ui:SymbolIcon Symbol="FolderOpen24" />
                                        </ui:Button.Icon>
                                    </ui:Button>
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
                            <ui:Button
                                MinWidth="140"
                                Appearance="Primary"
                                Command="{Binding SaveCommand}"
                                Content="Speichern">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Save24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <TextBlock
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource Hint}"
                                Text="Änderungen werden auch beim Verbinden und Beenden automatisch gespeichert." />
                        </StackPanel>

                        <ui:InfoBar
                            Title="{Binding StatusTitle}"
                            Margin="0,12,0,0"
                            IsClosable="True"
                            IsOpen="{Binding IsStatusOpen, Mode=TwoWay}"
                            Message="{Binding StatusMessage}"
                            Severity="{Binding StatusSeverity}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</ui:FluentWindow>
